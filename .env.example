# xAI / Grok Imagine API — https://console.x.ai
XAI_API_KEY=

# Upload-Post — https://app.upload-post.com → API Keys
# Docs: https://docs.upload-post.com/
UPLOAD_POST_API_KEY=
# Per-workspace publish user is set in clients/<id>/publish.json
UPLOAD_POST_DEFAULT_USER=

# Brand Brain research (optional)
# Use public Jina reader as fallback when native HTML fetch fails (default on). Set 0 to disable.
# RESEARCH_JINA_FALLBACK=0

PORT=8787

# fal.ai multi-model gateway — https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — story-reel voiceover (spoken captions always; VO when key set)
# https://elevenlabs.io → API Keys — voice is AUTO-PICKED for peer UGC tone
ELEVENLABS_API_KEY=
# Optional overrides (leave blank to let AI pick):
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_PROFILE=peer_male   # peer_male | peer_female | narrator
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Grok vision for Character Reverse-Engineer (optional; defaults try vision models)
# GROK_VISION_MODEL=grok-2-vision-latest
# GROK_IMAGE_MODEL=grok-imagine-image-quality
